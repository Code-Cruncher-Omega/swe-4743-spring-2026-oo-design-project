meta {
  name: Create Device
  type: http
  seq: 1
}

post {
  url: {{api_base}}/devices
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Living Room Light",
    "location": "Living Room",
    "deviceType": "LIGHT"
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  const location = res.getHeader("location");
  test("Location header present", function() {
    expect(location).to.exist;
  });

  if (location) {
    const deviceId = location.split('/').pop();
    bru.setEnvVar("createdDeviceId", deviceId);
  }

  test("Created device ID stored", function() {
    expect(bru.getEnvVar("createdDeviceId")).to.exist;
  });
}
